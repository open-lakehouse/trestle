{
  "name": "@open-lakehouse/stack-wasm",
  "version": "0.0.0",
  "description": "The trestle environment planner's TypeScript surface: the DTO and Planner types, the captured fixtures, and a fixture-backed planner",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-lakehouse/trestle.git",
    "directory": "node/stack-wasm"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.stories.tsx",
    "!src/index.ts",
    "!src/pkg.d.ts",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts"
    },
    "./stub": {
      "source": "./src/stub.ts",
      "types": "./dist/stub.d.ts",
      "import": "./dist/stub.js"
    },
    "./types": {
      "source": "./src/types.ts",
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./fixtures": {
      "source": "./src/fixtures.ts",
      "types": "./dist/fixtures.d.ts",
      "import": "./dist/fixtures.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun ../scripts/build-package.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
