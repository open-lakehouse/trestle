{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "customConditions": [],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.stories.tsx",
    "pkg",
    "src/index.ts",
    "src/pkg.d.ts"
  ]
}
