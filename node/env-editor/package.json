{
  "name": "@open-lakehouse/env-editor",
  "version": "0.0.0",
  "description": "The trestle environment editor: a headless React component and IDE-style workspace shell over injected Planner and WorkspaceStore seams",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-lakehouse/trestle.git",
    "directory": "node/env-editor"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.stories.tsx",
    "DESIGN.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./diagram": {
      "source": "./src/diagram/index.ts",
      "types": "./dist/diagram/index.d.ts",
      "import": "./dist/diagram/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun ../scripts/build-package.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@open-lakehouse/stack-wasm": "workspace:*",
    "@open-lakehouse/ui-kit": "workspace:*",
    "@xyflow/react": "^12.4.0",
    "elkjs": "^0.11.0",
    "fflate": "^0.8.2",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.55.0",
    "shiki": "^3.23.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@open-lakehouse/host": "workspace:*",
    "@storybook/react-vite": "^10.6.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "^10.6.0",
    "typescript": "^5.7.0"
  }
}
