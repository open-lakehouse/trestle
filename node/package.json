{
  "name": "@open-lakehouse/trestle-web",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "ui-kit",
    "host",
    "stack-wasm",
    "env-editor",
    "trestle-diagram",
    "env-app"
  ],
  "scripts": {
    "postinstall": "bun scripts/strip-lock-proxy.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test --conditions=source",
    "dev": "bun run --filter @open-lakehouse/env-editor-app dev",
    "build": "bun run --filter @open-lakehouse/env-editor-app build",
    "storybook": "bun run --filter @open-lakehouse/env-editor-app storybook",
    "build:diagram": "bun run --filter @open-lakehouse/trestle-diagram build",
    "build:packages": "for p in ui-kit host stack-wasm env-editor; do (cd $p && bun run build) || exit 1; done",
    "build-storybook": "bun run --filter @open-lakehouse/env-editor-app build-storybook"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "typescript": "^5.7.0"
  }
}
