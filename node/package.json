{
  "name": "@open-lakehouse/trestle-web",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "ui-kit",
    "stack-wasm",
    "env-editor",
    "env-app"
  ],
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "bun run --filter '*' typecheck",
    "dev": "bun run --filter @open-lakehouse/env-editor-app dev",
    "build": "bun run --filter @open-lakehouse/env-editor-app build",
    "storybook": "bun run --filter @open-lakehouse/env-editor-app storybook"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "typescript": "^5.7.0"
  }
}
