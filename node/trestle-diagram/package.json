{
  "name": "@open-lakehouse/trestle-diagram",
  "version": "0.0.0",
  "description": "Embed trestle environment diagrams, read-only, from a graph snapshot",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-lakehouse/trestle.git",
    "directory": "node/trestle-diagram"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "vite build && rollup -c rollup.dts.config.mjs && node scripts/check-dist.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-tooltip": "^1.2.8",
    "@xyflow/react": "^12.4.0",
    "clsx": "^2.1.1",
    "elkjs": "^0.11.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.475.0",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@open-lakehouse/env-editor": "workspace:*",
    "@open-lakehouse/stack-wasm": "workspace:*",
    "@open-lakehouse/ui-kit": "workspace:*",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "lightningcss": "^1.30.0",
    "postcss": "^8.4.0",
    "postcss-selector-parser": "^7.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rollup": "^4.0.0",
    "rollup-plugin-dts": "^6.2.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
