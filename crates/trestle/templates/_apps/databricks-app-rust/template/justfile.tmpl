set dotenv-load := true
set dotenv-filename := ".env.local"

project := "{{ project_name | kebab_case }}"

# ------------------------------------------------------------------------------
# Codegen
# ------------------------------------------------------------------------------

# Regenerate all code from proto. `trestle generate` drives the whole pipeline:
# buf plugins (models{% if with_connect %} + Connect facade{% endif %}), the proto descriptor, and the
# trestle-generated server/client/TS{% if with_frontend %}, then the browser WASM client{% endif %}.
regen:
    trestle generate -c trestle.yaml
{%- if with_frontend %}
    just build-wasm
    cd frontend && npm install
{%- endif %}

{% if with_frontend -%}
# Compile the generated client crate to a browser WASM module (requires
# `wasm-pack`: `cargo install wasm-pack`). Output lands in `frontend/src/wasm/`,
# imported by the app via the `@/wasm` alias.
build-wasm:
    wasm-pack build crates/client --target web --out-dir ../../frontend/src/wasm --out-name client
{% endif %}

# ------------------------------------------------------------------------------
# Dev loop
# ------------------------------------------------------------------------------

# Run the server (and frontend, if enabled) in watch mode. Bring up the composed
# dev environment separately first with `trestle env` (see the project README).
{% if with_frontend -%}
dev:
    cargo run -p {{ project_name | kebab_case }}-server &
    cd frontend && npm run dev
{%- else %}
dev:
    cargo run -p {{ project_name | kebab_case }}-server
{%- endif %}

# ------------------------------------------------------------------------------
# Databricks Apps
# ------------------------------------------------------------------------------

# Validate the asset bundle (no deploy).
bundle-validate:
    databricks bundle validate

# Deploy the bundle.
deploy:
    databricks bundle deploy
    databricks bundle run {{ project_name | snake_case }}

# ------------------------------------------------------------------------------
# Quality
# ------------------------------------------------------------------------------

fmt:
    cargo fmt --all
{% if with_frontend -%}
    cd frontend && npm run format
{%- endif %}

lint:
    cargo clippy --all-targets -- -D warnings
    buf lint
{% if with_frontend -%}
    cd frontend && npm run lint
{%- endif %}

test:
    cargo test --workspace --lib --tests
