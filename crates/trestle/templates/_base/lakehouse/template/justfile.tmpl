# Project recipes. The composed local dev environment is created separately with
# `trestle env new` (which owns the Docker Compose surface); once it is rendered,
# run `docker compose up` from that environment directory.

# Show available recipes.
default:
    @just --list

# Create (or overwrite) the local composed environment under ./env.
env:
    trestle env new {{ project_name }} --out-dir env --force

# Re-render the environment from ./env/env.toml after editing the selection.
env-render:
    trestle env render env

# Build proto descriptors + regenerate code.
regen:
    trestle generate
