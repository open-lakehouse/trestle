# Client environment for callers inside the compose network. Generated; re-render to update.
# Load it into an app, notebook, or engine to reach this stack. It holds no
# credentials: authenticate through the gateway, and read/write object storage
# with the temporary credentials Unity Catalog vends.
AWS_ALLOW_HTTP=true
AWS_ENDPOINT_URL=http://envoy:9000
AWS_ENDPOINT_URL_S3=http://envoy:9000
AWS_REGION=us-east-1
UNITY_CATALOG_URL=http://envoy:10000/api/2.1/unity-catalog
