# Open Policy Agent — the gateway's authorization policy engine (Envoy ext_authz over gRPC).
# Envoy consults it for every request on the shared listener after Authelia authenticates it.
services:
  opa:
    image: {{ knobs.image }}
    restart: unless-stopped
    # The REST API stays on loopback; only the ext_authz gRPC port is reachable in-network.
    command:
      - "run"
      - "--server"
      - "--addr=localhost:8181"
      - "--config-file=/config/config.yaml"
      - "--log-level={{ knobs.log_level }}"
      - "/policies"
    configs:
      - source: opa_config
        target: /config/config.yaml
      - source: opa_policy
        target: /policies/authz.rego
      - source: opa_policy_test
        target: /policies/authz_test.rego
    expose:
      - "9191"
    healthcheck:
      # OPA's `/health?plugins` (200 once the policies are loaded and the ext_authz plugin is up),
      # on the loopback REST API. The image is distroless, so OPA's own `http.send` probes it:
      # the query is undefined, failing `--fail`, unless the status is 200.
      test:
        - "CMD"
        - "/opa"
        - "eval"
        - "--fail"
        - 's := http.send({"method": "GET", "url": "http://localhost:8181/health?plugins"}).status_code; s == 200'
      interval: 5s
      timeout: 5s
      retries: 10
