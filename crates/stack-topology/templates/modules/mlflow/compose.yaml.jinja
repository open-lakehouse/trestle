# MLflow tracking server
services:
  mlflow:
    image: {{ knobs.image }}
    restart: unless-stopped
    depends_on:
{%- for dep in dependencies %}
      {{ dep.service }}:
        condition: {{ dep.condition }}
{%- endfor %}
    command:
      - "mlflow"
      - "server"
      - "--serve-artifacts"
      - "--host"
      - "0.0.0.0"
      - "--port"
      - "5000"
      - "--static-prefix"
      - "{{ env.BASE_PATH }}"
    env_file:
      - path: ./modules/mlflow/.env/mlflow.env
        format: raw
    expose:
      - "5000"
    healthcheck:
      test:
        - "CMD-SHELL"
        - "python3 -c \"import urllib.request; urllib.request.urlopen('http://127.0.0.1:5000{{ env.BASE_PATH }}/health')\""
      interval: 5s
      timeout: 5s
      retries: 10
      start_period: 10s
