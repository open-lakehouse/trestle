# MLflow tracking server, with its built-in AI Gateway
services:
  mlflow:
    image: {{ knobs.image }}
    restart: unless-stopped
{%- if dependencies %}
    depends_on:
{%- for dep in dependencies %}
      {{ dep.service }}:
        condition: service_{{ dep.readiness }}
{%- endfor %}
{%- endif %}
    command:
      - "mlflow"
      - "server"
      - "--serve-artifacts"
      - "--host"
      - "0.0.0.0"
      - "--port"
      - "5000"
      - "--static-prefix"
      - "{{ env.BASE_PATH }}"
{%- if "unity-catalog" in stack.modules %}
      # One model registry per environment: with Unity Catalog in the stack, MLflow's registry
      # API and UI read and write UC models, called directly on the compose network.
      - "--registry-store-uri"
      - "uc:{{ knobs.uc_url }}"
{%- endif %}
    env_file:
      - path: ./modules/mlflow/.env/mlflow.env
        format: raw
    environment:
      # The Host headers MLflow accepts: browsers on localhost (or the gateway's `*.localhost`
      # name under auth), in-network callers through the gateway, and the gateway-init job
      # calling it directly.
      MLFLOW_SERVER_ALLOWED_HOSTS: "localhost,localhost:*,127.0.0.1,127.0.0.1:*,{% if env.GATEWAY_INTERNAL_URL %}{{ env.GATEWAY_INTERNAL_URL | replace('http://', '') }},{% endif %}mlflow:5000{% if env.GATEWAY_AUTH == "true" %},{{ env.GATEWAY_HOST }},{{ env.GATEWAY_HOST }}:*{% endif %}"
{%- if "unity-catalog" in stack.modules %}
      # Makes the mounted package visible: its entry point registers MLflow's OSS Unity Catalog
      # store for the `uc:` scheme, which the server otherwise doesn't accept.
      PYTHONPATH: /opt/trestle/mlflow-plugins
      # Registering a model version copies its files into UC's storage; the UC store downloads
      # them first through this tracking URI, i.e. from the server itself.
      MLFLOW_TRACKING_URI: http://127.0.0.1:5000{{ env.BASE_PATH }}
    configs:
      - source: mlflow_uc_registry_module
        target: /opt/trestle/mlflow-plugins/trestle_mlflow_uc_registry.py
      - source: mlflow_uc_registry_metadata
        target: /opt/trestle/mlflow-plugins/trestle_mlflow_uc_registry-0.0.0.dist-info/METADATA
      - source: mlflow_uc_registry_entry_points
        target: /opt/trestle/mlflow-plugins/trestle_mlflow_uc_registry-0.0.0.dist-info/entry_points.txt
{%- endif %}
    expose:
      - "5000"
{%- if published_ports %}
    ports:
{%- for p in published_ports %}
      - "{{ p.host }}:{{ p.container }}"
{%- endfor %}
{%- endif %}
    healthcheck:
      test:
        - "CMD-SHELL"
        - "python3 -c \"import urllib.request; urllib.request.urlopen('http://127.0.0.1:5000{{ env.BASE_PATH }}/health')\""
      interval: 5s
      timeout: 5s
      retries: 10
      start_period: 10s

  # Seeds the AI Gateway with one endpoint per configured model, storing the provider keys
  # exported in your shell. Idempotent: re-runs on every `up` and leaves existing endpoints alone.
  mlflow-gateway-init:
    image: {{ knobs.image }}
    restart: "no"
    command: ["python", "/seed_gateway.py"]
    environment:
      MLFLOW_URL: http://mlflow:5000{{ env.BASE_PATH }}
      MLFLOW_GATEWAY_MODELS: "{{ knobs.ai_gateway_models }}"
      # Provider keys, passed through from the shell running `docker compose up` (a bare name
      # takes the caller's value, or stays unset): never written into the rendered stack.
      ANTHROPIC_API_KEY:
      OPENAI_API_KEY:
      GEMINI_API_KEY:
    configs:
      - source: mlflow_seed_gateway
        target: /seed_gateway.py
    depends_on:
      mlflow:
        condition: service_healthy
