# Unity Catalog
services:
  unitycatalog:
    image: {{ knobs.image }}
    restart: unless-stopped
    depends_on:
{%- for dep in dependencies %}
      {{ dep.service }}:
        condition: {{ dep.condition }}
{%- endfor %}
    secrets:
      - source: unitycatalog_server_properties
        target: /home/unitycatalog/etc/conf/server.properties
{%- set obj = connections.object_store.0 %}
{%- if obj.tls_trust %}
    environment:
      # Trust the gateway's local CA, which answers the AWS STS/S3 hostnames UC calls.
      JAVA_TOOL_OPTIONS: -Djavax.net.ssl.trustStore={{ obj.tls_trust.jvm_truststore }} -Djavax.net.ssl.trustStorePassword={{ obj.tls_trust.jvm_truststore_password }}
    volumes:
      - {{ obj.tls_trust.volume }}:{{ obj.tls_trust.mount_path }}:ro
{%- endif %}
    expose:
      - "8080"
    healthcheck:
      test:
        ["CMD-SHELL", "wget -q --spider http://127.0.0.1:8080/api/2.1/unity-catalog/catalogs || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 12
      start_period: 15s
