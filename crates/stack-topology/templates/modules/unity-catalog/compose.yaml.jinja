# Unity Catalog
services:
  unitycatalog:
{%- if knobs.container_name %}
    container_name: {{ knobs.container_name }}
{%- endif %}
{%- if knobs.build %}
    # Built locally from the render root, tagged with the `image` knob.
    build:
      context: ./{{ knobs.build }}
    pull_policy: build
{%- endif %}
    image: {{ knobs.image }}
    # The server ignores SIGTERM as PID 1.
    init: true
    restart: unless-stopped
{%- set writable = knobs.writable_mounts and knobs.extra_mounts %}
{%- if dependencies or writable %}
    depends_on:
{%- for dep in dependencies %}
      {{ dep.service }}:
        condition: service_{{ dep.readiness }}
{%- endfor %}
{%- if writable %}
      unitycatalog-mounts:
        condition: service_completed_successfully
{%- endif %}
{%- endif %}
    secrets:
      - source: unitycatalog_server_properties
        target: /home/unitycatalog/etc/conf/server.properties
{%- if connections.relational_db %}
      # Points the metadata store at the relational_db provider instead of the built-in H2.
      - source: unitycatalog_hibernate_properties
        target: /home/unitycatalog/etc/conf/hibernate.properties
{%- endif %}
{%- set obj = connections.object_store[0] if connections.object_store else none %}
{%- set trust = obj.tls_trust if obj else none %}
{%- if trust %}
    environment:
      # Trust the gateway's local CA, which answers the AWS STS/S3 hostnames UC calls.
      JAVA_TOOL_OPTIONS: -Djavax.net.ssl.trustStore={{ trust.jvm_truststore }} -Djavax.net.ssl.trustStorePassword={{ trust.jvm_truststore_password }}
{%- endif %}
{%- if trust or knobs.extra_mounts %}
    volumes:
{%- if trust %}
      - {{ trust.volume }}:{{ trust.mount_path }}:ro
{%- endif %}
{%- if knobs.extra_mounts %}
{%- for mount in knobs.extra_mounts | split(";") %}
      - {{ mount | trim }}
{%- endfor %}
{%- endif %}
{%- endif %}
    expose:
      - "8080"
    healthcheck:
      test:
        ["CMD-SHELL", "wget -q --spider http://127.0.0.1:8080/api/2.1/unity-catalog/catalogs || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 12
      start_period: 15s
{%- if writable %}

  # One-shot: Docker creates a missing bind source owned by root, so open the paths up for
  # the server and for host-side clients that write to the same directories.
  unitycatalog-mounts:
    image: {{ knobs.storage_image }}
    user: root
    restart: "no"
    entrypoint:
      - chmod
      - "0777"
{%- for path in knobs.writable_mounts | split(";") %}
      - "{{ path | trim }}"
{%- endfor %}
    volumes:
{%- for mount in knobs.extra_mounts | split(";") %}
      - {{ mount | trim }}
{%- endfor %}
{%- endif %}
{%- if knobs.storage_bootstrap == "api" and connections.object_store %}

  # Registers the object store in UC's database (a storage credential and an external location
  # per bucket, plus `default_catalog`), so server.properties carries only the master identity.
  # It stays up and turns healthy once done, so `up --wait` waits for registration too.
  unitycatalog-storage:
    image: {{ knobs.storage_image }}
    init: true
    restart: "no"
    command: ["python", "/bootstrap_storage.py"]
    configs:
      - source: unitycatalog_bootstrap_storage
        target: /bootstrap_storage.py
      - source: unitycatalog_storage
        target: /storage.txt
    depends_on:
      unitycatalog:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "test", "-f", "/tmp/registered"]
      interval: 2s
      timeout: 3s
      retries: 30
{%- endif %}
