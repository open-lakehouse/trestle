{%- if knobs.storage_bootstrap == "api" and connections.object_store -%}
# Generated by trestle: what unitycatalog-storage registers, one object per line.
#   location <name> <url> <credential name> <role ARN>
#   catalog <name>   (managed storage under the first location)
{%- for obj in connections.object_store %}
{%- if obj.credential.flavour == "s3" and obj.credential.role_arn %}
location {{ obj.bucket }} {{ obj.uri }} {{ obj.bucket }}_storage {{ obj.credential.role_arn }}
{%- else %}
# {{ obj.uri }}: not registered; UC vends credentials only for an S3 store with an IAM role.
{%- endif %}
{%- endfor %}
{%- if knobs.default_catalog %}
catalog {{ knobs.default_catalog }}
{%- endif %}
{% endif -%}
