# Generated by trestle. A local, single-user server: authorization is disabled, so never use
# this configuration for a shared server.
server.env=dev
server.authorization=disable
{%- for obj in connections.object_store %}
{%- if obj.credential.flavour == "s3" %}

# The same per-bucket config you'd write for real AWS: no endpoint override.
s3.bucketPath.{{ loop.index0 }}={{ obj.uri }}
s3.region.{{ loop.index0 }}={{ obj.credential.region }}
{%- if obj.credential.role_arn %}
s3.awsRoleArn.{{ loop.index0 }}={{ obj.credential.role_arn }}
{%- endif %}
s3.accessKey.{{ loop.index0 }}={{ obj.credential.access_key_id }}
s3.secretKey.{{ loop.index0 }}={{ obj.credential.secret_access_key }}
{%- else %}

# {{ obj.uri }}: Unity Catalog's adls.* storage config needs a service principal, which a
# local emulator can't provide, so this store is not registered for credential vending.
{%- endif %}
{%- endfor %}
