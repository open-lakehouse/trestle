{%- set routes = egress_routes | selectattr("mcp") | list -%}
{%- if routes -%}
# Written by trestle: Omnigent's MCP registry (`OMNIGENT_MCP_REGISTRY`), one service per egress
# route serving MCP. The egress gateway adds each route's credential, so the server calls it
# with none and plain HTTP stays on the compose network.
services:
{%- for r in routes %}
  - id: {{ r.name | tojson }}
    title: {{ r.mcp.title | tojson }}
    url: {{ r.url | tojson }}
    auth: none
    allow_http: true
    tools:
{%- for t in r.mcp.tools %}
      - {{ t | tojson }}
{%- endfor %}
{%- endfor %}
{% endif -%}
