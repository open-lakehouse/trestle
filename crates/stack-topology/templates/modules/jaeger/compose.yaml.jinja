# Jaeger tracing
services:
  jaeger:
    image: {{ knobs.image }}
    restart: unless-stopped
    command: ["--set=extensions.jaeger_query.base_path=/jaeger"]
    expose:
      - "16686"
      - "4317"
      - "4318"
{%- if published_ports %}
    ports:
{%- for p in published_ports %}
      - "{{ p.host }}:{{ p.container }}"
{%- endfor %}
{%- endif %}
