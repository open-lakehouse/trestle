# Azurite (Azure Blob emulator)
services:
  azurite:
    image: {{ knobs.image }}
    restart: unless-stopped
    command:
      ["azurite-blob", "--blobHost", "0.0.0.0", "--blobPort", "10000", "--skipApiVersionCheck"]
    expose:
      - "10000"
    volumes:
      - {{ env.DATA_ROOT }}/azurite:/data
    healthcheck:
      test:
        - "CMD-SHELL"
        - "nc -z 127.0.0.1 10000 || exit 1"
      interval: 5s
      timeout: 5s
      retries: 10
      start_period: 3s
{%- if objects %}

  azurite-init:
    image: {{ knobs.init_image }}
    restart: "no"
    depends_on:
      azurite:
        condition: service_healthy
    env_file:
      - path: ./modules/azurite/.env/azurite-init.env
        format: raw
    entrypoint:
      - "sh"
      - "-c"
      - |
        echo "Creating Azurite containers...";
{%- for name in objects %}
        az storage container create --name {{ name }} 2>&1 || true;
{%- endfor %}
        echo "Containers ready.";
{%- endif %}
