{#- The stack's Unity Catalog server, whichever implementation serves the API: in the stack,
    or hosted as a function and called at its URL. A set `uc_url` knob wins either way. #}
{%- set uc = stack.apis["unity-catalog"] %}
{%- set uc_runs = uc not in stack.functions %}
{%- set uc_url = knobs.uc_url or ("http://unitycatalog:8080" if uc_runs else stack.functions[uc].url | trim("/")) -%}
[
  {
    "name": "uc",
    "type": "deltalake",
    "metastore": {
      "type": "unity",
      "host": "{{ uc_url }}",
      "token": "local",
      "databricksCatalogName": "{{ knobs.catalog }}"
    }
  }
]
