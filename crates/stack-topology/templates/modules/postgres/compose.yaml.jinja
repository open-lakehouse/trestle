# Postgres + pgweb — contributed by the `postgres` module.
services:
  db:
    image: {{ knobs.image }}
    restart: unless-stopped
    env_file:
      - path: ./modules/postgres/.env/db.env
        format: raw
    secrets:
      - postgres_password
    expose:
      - "5432"
    volumes:
      - {{ env.DATA_ROOT }}/postgres:/var/lib/postgresql/data
    configs:
      - source: postgres_init
        target: /docker-entrypoint-initdb.d/init-databases.sh
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 5s
      timeout: 5s
      retries: 5

  pgweb:
    image: {{ knobs.pgweb_image }}
    restart: unless-stopped
    profiles: [svc, full]
    depends_on:
      db:
        condition: service_healthy
    env_file:
      - path: ./modules/postgres/.env/pgweb.env
        format: raw
    expose:
      - "8081"
