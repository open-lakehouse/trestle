# Postgres — contributed by the `postgres` module.
services:
  db:
    image: {{ knobs.image }}
    restart: unless-stopped
    env_file:
      - path: ./modules/postgres/.env/db.env
        format: raw
    secrets:
      - postgres_password
    expose:
      - "5432"
    volumes:
{%- if knobs.data == "volume" %}
      - postgres-data:/var/lib/postgresql/data
{%- else %}
      - {{ env.DATA_ROOT }}/postgres:/var/lib/postgresql/data
{%- endif %}
    configs:
      - source: postgres_init
        target: /docker-entrypoint-initdb.d/init-databases.sh
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 5s
      timeout: 5s
      retries: 5
{%- if knobs.data == "volume" %}

volumes:
  postgres-data:
{%- endif %}
