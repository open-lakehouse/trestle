# Unity Catalog MCP: mangrove's `uc mcp serve` over Streamable HTTP
{#- The `Host` values the server accepts (`host` allows any port): loopback, its own service
    name for in-network clients that call it directly, and the gateway's host-side and
    in-network names, which Envoy forwards unchanged. A list replaces the server's loopback
    default, so loopback is listed too. #}
{%- set allowed_hosts = ["localhost", "127.0.0.1", "uc-mcp"] %}
{%- if env.GATEWAY_HOST and env.GATEWAY_HOST not in allowed_hosts %}
{%- set allowed_hosts = allowed_hosts + [env.GATEWAY_HOST] %}
{%- endif %}
{%- if env.GATEWAY_INTERNAL_HOST and env.GATEWAY_INTERNAL_HOST not in allowed_hosts %}
{%- set allowed_hosts = allowed_hosts + [env.GATEWAY_INTERNAL_HOST] %}
{%- endif %}
{#- The stack's Unity Catalog server, whichever implementation serves the API: in the stack,
    or hosted as a function and called at its URL. A set `uc_url` knob wins either way. #}
{%- set uc = stack.apis["unity-catalog"] %}
{%- set uc_runs = uc not in stack.functions %}
{%- set uc_url = knobs.uc_url or ("http://unitycatalog:8080" if uc_runs else stack.functions[uc].url | trim("/")) %}
services:
  uc-mcp:
    image: {{ knobs.image }}
    restart: unless-stopped
    entrypoint: ["/usr/local/bin/uc"]
    # No token: the stack's Unity Catalog server is anonymous, in a container or as a function.
    # The MCP server does no inbound authentication; the gateway is its only boundary.
    command:
      - --server
      - "{{ uc_url }}"
      - mcp
      - serve
      - --http
      - 0.0.0.0:8090
      - --path
      - /uc-mcp/mcp
{%- for host in allowed_hosts %}
      - --allowed-host
      - "{{ host }}"
{%- endfor %}
{%- if uc_runs %}
    depends_on:
      unitycatalog:
        condition: service_healthy
{%- endif %}
    expose:
      - "8090"
{%- if published_ports %}
    ports:
{%- for p in published_ports %}
      - "{{ p.host }}:{{ p.container }}"
{%- endfor %}
{%- endif %}
    # Replaces the image's own check, which probes the catalog server's port (8080).
    healthcheck:
      test: ["CMD", "/usr/local/bin/uc-server", "healthcheck", "--url", "http://127.0.0.1:8090/health"]
      interval: 10s
      timeout: 5s
      start_period: 20s
      retries: 5
