# Generated by trestle. A local, single-user server: authorization is disabled, so never use
# this configuration for a shared server.
server.env=dev
server.authorization=disable
{%- set obj = connections.object_store[0] if connections.object_store else none %}
{%- if obj and obj.credential.flavour == "s3" %}

# The master identity UC signs AWS calls with: it assumes a storage credential's role to vend
# temporary credentials. The storage itself (credentials, external locations) is registered in
# UC's database, not here. No endpoint override, which UC doesn't support.
aws.accessKey={{ obj.credential.access_key_id }}
aws.secretKey={{ obj.credential.secret_access_key }}
aws.region={{ obj.credential.region }}
{%- if knobs.master_role_arn or obj.credential.role_arn %}
aws.masterRoleArn={{ knobs.master_role_arn or obj.credential.role_arn }}
{%- endif %}
{%- elif obj %}

# {{ obj.uri }}: Unity Catalog's adls.* storage config needs a service principal, which a
# local emulator can't provide, so this store is not registered for credential vending.
{%- endif %}
