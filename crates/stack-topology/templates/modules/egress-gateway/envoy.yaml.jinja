# Egress Envoy config, rendered from the planner's egress routes. One listener per route:
# `credential_injector` has no per-route configuration, so each credential needs its own
# filter chain. Credentials come from the secret server over SDS and are never written here.

# SDS over gRPC needs a node id and cluster.
node: { id: egress-gateway, cluster: egress-gateway }

static_resources:
  listeners:
{%- for r in egress.routes %}
    - name: {{ r.name }}
      address:
        socket_address: { address: 0.0.0.0, port_value: {{ r.port }} }
      filter_chains:
        - filters:
            - name: envoy.filters.network.http_connection_manager
              typed_config:
                "@type": type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
                codec_type: AUTO
                stat_prefix: egress_{{ r.upstream.cluster }}
                access_log:
                  - name: envoy.access_loggers.stdout
                    typed_config:
                      "@type": type.googleapis.com/envoy.extensions.access_loggers.stream.v3.StdoutAccessLog
                      log_format:
                        text_format_source:
                          inline_string: "{{ r.name }} %REQ(:METHOD)% %REQ(:PATH)% -> %UPSTREAM_CLUSTER% %RESPONSE_CODE%\n"
                route_config:
                  name: {{ r.name }}
                  virtual_hosts:
                    - name: {{ r.name }}
                      domains: ["*"]
                      routes:
                        # Only the route's path (and what is under it) is forwarded, unchanged;
                        # anything else is a 404.
{%- if r.path == "/" %}
                        - match: { prefix: "/" }
{%- else %}
                        - match: { path_separated_prefix: "{{ r.path }}" }
{%- endif %}
                          route:
                            cluster: {{ r.upstream.cluster }}
                            # The upstream sees its own host, not the gateway's.
                            auto_host_rewrite: true
                            # Model output and MCP sessions stream.
                            timeout: 0s
                http_filters:
                  # The caller's own credentials go before injection. A route's
                  # `request_headers_to_remove` would run in the router, after the injector,
                  # and remove the injected header too.
                  - name: envoy.filters.http.header_mutation
                    typed_config:
                      "@type": type.googleapis.com/envoy.extensions.filters.http.header_mutation.v3.HeaderMutation
                      mutations:
                        request_mutations:
                          - remove: authorization
                          - remove: x-api-key
                  # Adds the route's credential: `overwrite` so no caller can put its own in its
                  # place, and never forwards a request without one (a missing secret is a 401).
                  - name: envoy.filters.http.credential_injector
                    typed_config:
                      "@type": type.googleapis.com/envoy.extensions.filters.http.credential_injector.v3.CredentialInjector
                      overwrite: true
                      allow_request_without_credential: false
                      credential:
{%- if r.credential.kind == "oauth2_client_credentials" %}
                        name: envoy.http.injected_credentials.oauth2
                        typed_config:
                          "@type": type.googleapis.com/envoy.extensions.http.injected_credentials.oauth2.v3.OAuth2
                          token_endpoint:
                            uri: {{ r.token_endpoint.uri }}
                            cluster: {{ r.token_endpoint.upstream.cluster }}
                            timeout: 5s
{%- if r.credential.scopes %}
                          scopes:
{%- for s in r.credential.scopes %}
                            - "{{ s }}"
{%- endfor %}
{%- endif %}
                          client_credentials:
                            client_id: "{{ r.credential.client_id }}"
                            client_secret:
                              name: {{ r.name }}
                              sds_config:
                                resource_api_version: V3
                                initial_fetch_timeout: 10s
                                api_config_source:
                                  api_type: GRPC
                                  transport_api_version: V3
                                  grpc_services:
                                    - envoy_grpc: { cluster_name: secret_server }
{%- else %}
                        name: envoy.http.injected_credentials.generic
                        typed_config:
                          "@type": type.googleapis.com/envoy.extensions.http.injected_credentials.generic.v3.Generic
{%- if r.credential.kind == "bearer" %}
                          header: Authorization
                          header_value_prefix: "Bearer "
{%- else %}
                          header: "{{ r.credential.name }}"
{%- if r.credential.prefix %}
                          header_value_prefix: "{{ r.credential.prefix }}"
{%- endif %}
{%- endif %}
                          credential:
                            name: {{ r.name }}
                            sds_config:
                              resource_api_version: V3
                              initial_fetch_timeout: 10s
                              api_config_source:
                                api_type: GRPC
                                transport_api_version: V3
                                grpc_services:
                                  - envoy_grpc: { cluster_name: secret_server }
{%- endif %}
                  - name: envoy.filters.http.router
                    typed_config:
                      "@type": type.googleapis.com/envoy.extensions.filters.http.router.v3.Router
{%- else %} []
{%- endfor %}
  clusters:
    # The secret server, over the Unix socket on the volume only this container shares with it.
{%- for c in egress.sds_consumers if c.name == "egress-gateway" %}
    - name: secret_server
      type: STATIC
      connect_timeout: 2s
      typed_extension_protocol_options:
        envoy.extensions.upstreams.http.v3.HttpProtocolOptions:
          "@type": type.googleapis.com/envoy.extensions.upstreams.http.v3.HttpProtocolOptions
          explicit_http_config:
            http2_protocol_options: {}
      load_assignment:
        cluster_name: secret_server
        endpoints:
          - lb_endpoints:
              - endpoint:
                  address:
                    pipe: { path: {{ c.socket }} }
{%- endfor %}
{%- for u in egress.clusters %}
    # Outside the environment{{ ", over TLS: verified against the system trust store" if u.tls }}.
    - name: {{ u.cluster }}
{%- if u.tls %}
      type: LOGICAL_DNS
      dns_lookup_family: V4_PREFERRED
      connect_timeout: 5s
{%- else %}
      type: STRICT_DNS
      connect_timeout: 2s
{%- endif %}
      load_assignment:
        cluster_name: {{ u.cluster }}
        endpoints:
          - lb_endpoints:
              - endpoint:
                  address:
                    socket_address:
                      address: {{ u.host }}
                      port_value: {{ u.port }}
{%- if u.tls %}
      transport_socket:
        name: envoy.transport_sockets.tls
        typed_config:
          "@type": type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.UpstreamTlsContext
          sni: {{ u.tls }}
          common_tls_context:
            validation_context:
              trusted_ca: { filename: /etc/ssl/certs/ca-certificates.crt }
              match_typed_subject_alt_names:
                - san_type: DNS
                  matcher: { exact: "{{ u.tls }}" }
{%- endif %}
{%- endfor %}

# Admin binds the container's loopback and is never published: only the in-container health
# check reaches /ready, and nothing on the network reaches /config_dump or /quitquitquit.
admin:
  address:
    socket_address: { address: 127.0.0.1, port_value: {{ admin_port }} }
