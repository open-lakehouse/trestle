# The secret server's configuration: which consumer may ask for which secret on which socket,
# and which launch variable holds each one. Names only; the values never reach this file.
version: 1
listeners:
{%- for c in egress.sds_consumers %}
  - socket: {{ c.server_socket }}
    consumer: {{ c.name }}
{%- if c.name == "egress-gateway" and egress.routes %}
    secrets:
{%- for r in egress.routes %}
      - name: {{ r.name }}
        env: {{ r.credential.secret if r.credential.kind != "oauth2_client_credentials" else r.credential.client_secret }}
{%- endfor %}
{%- else %}
    secrets: []
{%- endif %}
{%- endfor %}
