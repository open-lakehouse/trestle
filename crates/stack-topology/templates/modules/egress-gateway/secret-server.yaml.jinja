# The secret server's configuration: which consumer may ask for which secret, and wrap and
# unwrap under which key, on which socket, and which launch variable holds each secret and
# keyring. Names only; the values never reach this file.
version: 1
{%- if egress.host %}
# The values come from the launcher's host endpoint, under this instance's path token.
source:
  kind: host
  url: {{ egress.host.url }}
  token_env: {{ egress.host.token_env }}
{%- endif %}
listeners:
{%- for c in egress.sds_consumers %}
  - socket: {{ c.server_socket }}
    consumer: {{ c.name }}
{%- if c.secrets %}
    secrets:
{%- for s in c.secrets %}
      - name: {{ s.name }}
        env: {{ s.env }}
{%- endfor %}
{%- else %}
    secrets: []
{%- endif %}
{%- if c.keys %}
    keys:
{%- for k in c.keys %}
      - name: {{ k.name }}
        env: {{ k.env }}
{%- endfor %}
{%- endif %}
{%- endfor %}
