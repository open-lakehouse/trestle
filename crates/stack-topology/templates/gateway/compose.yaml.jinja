# Envoy gateway
services:
  envoy:
    image: {{ knobs.image }}
    restart: unless-stopped
    configs:
      - source: envoy_config
        target: /etc/envoy/envoy.yaml
    command: ["-c", "/etc/envoy/envoy.yaml", "--log-level", "warn"]
{%- if admin_port %}
    healthcheck:
      # Envoy's admin `/ready` answers 200 once every listener and cluster has initialized.
      # The image has bash but no curl, so the probe speaks HTTP over `/dev/tcp` itself.
      test:
        - "CMD"
        - "bash"
        - "-c"
        - >-
          exec 3<>/dev/tcp/127.0.0.1/{{ admin_port }}
          && printf 'GET /ready HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n' >&3
          && head -n1 <&3 | grep -q ' 200 '
      interval: 5s
      timeout: 5s
      retries: 10
      start_period: 5s
{%- endif %}
{%- if dependencies or tls %}
    depends_on:
{%- for dep in dependencies %}
      {{ dep.service }}:
        condition: service_{{ dep.readiness }}
{%- endfor %}
{%- if tls %}
      {{ tls.mint_service }}:
        condition: service_completed_successfully
{%- endif %}
{%- endif %}
{%- if published_ports %}
    ports:
{%- for p in published_ports %}
      - "{{ p.host }}:{{ p.container }}"
{%- endfor %}
{%- endif %}
{%- if tls %}
    volumes:
      - {{ tls.trust.volume }}:{{ tls.trust.mount_path }}:ro
{%- endif %}
{%- if tls or mesh %}
    networks:
{%- if tls %}
      default:
        # In-network clients resolve these hostnames to the gateway: emulated public hosts,
        # whose TLS it terminates with a local CA, and under forward-auth the dotted alias
        # in-network callers address the shared listener by. Compose DNS has no wildcards:
        # each host is listed.
        aliases:
{%- for h in tls.hosts %}
          - {{ h }}
{%- endfor %}
{%- else %}
      default: {}
{%- endif %}
{%- if mesh %}
      # Shared with the other environments: only the gateway joins it.
      mesh:
        aliases:
          - {{ mesh.alias }}
{%- endif %}
{%- endif %}
{%- if tls %}

  # One-shot: mints the local CA and the gateway's certificate for its TLS hostnames.
  {{ tls.mint_service }}:
    image: {{ knobs.certs_image }}
    entrypoint: ["bash", "/certs.sh"]
    environment:
      CERT_DIR: {{ tls.trust.mount_path }}
      CERT_HOSTS: "{{ tls.cert_hosts | join(' ') }}"
    configs:
      - source: gateway_certs_script
        target: /certs.sh
    volumes:
      - {{ tls.trust.volume }}:{{ tls.trust.mount_path }}

volumes:
  {{ tls.trust.volume }}:
{%- endif %}
{%- if mesh %}

networks:
  mesh:
    name: {{ mesh.name }}
{%- endif %}
