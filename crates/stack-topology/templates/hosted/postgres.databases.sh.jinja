{%- set v = hosted.values -%}
{%- if hosted.vendor == "neon" -%}
: "${NEON_PROJECT_ID:?set NEON_PROJECT_ID, or run the project step first}"
existing="$(neonctl databases list --project-id "$NEON_PROJECT_ID" --output json \
  | jq -r '(.databases // .)[] | .name')"
for db in {% for r in hosted.resources %}{{ r | shell }} {% endfor %}; do
  if printf '%s\n' "$existing" | grep -qx "$db"; then
    echo "database $db exists"
  else
    neonctl databases create --project-id "$NEON_PROJECT_ID" --name "$db" --output json >/dev/null
    echo "created database $db"
  fi
done
{%- else -%}
password_var={{ hosted.vars.password | shell }}
export PGHOST={{ v.host | shell }}
export PGPORT={{ v.port | shell }}
export PGUSER={{ v.username | shell }}
export PGPASSWORD="${!password_var:?set $password_var (see README.md)}"
{%- if v.ssl_mode %}
export PGSSLMODE={{ v.ssl_mode | shell }}
{%- endif %}
for db in {% for r in hosted.resources %}{{ r | shell }} {% endfor %}; do
  if [ "$(psql -d postgres -tAc "SELECT 1 FROM pg_database WHERE datname = '$db'")" = 1 ]; then
    echo "database $db exists"
  else
    psql -d postgres -qc "CREATE DATABASE \"$db\""
    echo "created database $db"
  fi
done
{%- endif %}
