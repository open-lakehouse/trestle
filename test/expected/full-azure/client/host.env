# Client environment for callers on the host (localhost addresses). Generated; re-render to update.
# Load it into an app, notebook, or engine to reach this stack. It holds no
# credentials: authenticate through the gateway, and read/write object storage
# with the temporary credentials Unity Catalog vends.
MLFLOW_AI_GATEWAY_URL=http://localhost:9080/ai-gateway
MLFLOW_ENABLE_PROXY_MULTIPART_DOWNLOAD=false
MLFLOW_ENABLE_PROXY_MULTIPART_UPLOAD=false
MLFLOW_REGISTRY_URI=uc:http://localhost:9080
MLFLOW_TRACKING_URI=http://localhost:9080
OPENLINEAGE_ENDPOINT=/api/v1/lineage
OPENLINEAGE_URL=http://localhost:9080
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:9080/v1/traces
OTEL_EXPORTER_OTLP_TRACES_PROTOCOL=http/protobuf
UNITY_CATALOG_URL=http://localhost:9080/api/2.1/unity-catalog
